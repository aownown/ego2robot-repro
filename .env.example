# Source this file or export equivalent variables.
export PROJECT=/path/to/ego2robot-repro
export WORKFLOW="$PROJECT/workflow"
export CLIP="$PROJECT/test_data"
export TEST_ROOT="$CLIP/_test1019"
export CONDA_BIN="$HOME/miniforge3/bin/conda"
export CUDA_VISIBLE_DEVICES=0
export PYOPENGL_PLATFORM=egl
export MUJOCO_GL=egl
export MPLBACKEND=Agg
export YOLO_AUTOINSTALL=false
export TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1
# Optional if reusing an already downloaded SAM 3 checkpoint:
# export SAM3_WEIGHT_PATH=/path/to/sam3.pt
